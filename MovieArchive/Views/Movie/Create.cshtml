@model MovieArchive.Models.Movie

@{
    ViewData["Title"] = "Add Movie";
}

<h1>Add Movie</h1>

<p>On this site, you can add movies to your collection!</p>
<p>Enter the details of the movie you want to add to your collection.</p>

<form asp-controller="Movie" asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Movie Title</label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="ReleaseYear" class="form-label">Release Year</label>
        <input asp-for="ReleaseYear"
               type="number"
               class="form-control"
               min="1888"
               required />
    </div>

    <button type="submit" class="btn btn-primary">
        Add Movie
    </button>
</form>