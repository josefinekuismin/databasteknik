@model List<MovieArchive.Models.Movie>

@{
    ViewData["Title"] = "Movie Collection";
    var watchlist = ViewBag.Watchlist as List<int>
        ?? new List<int>();
}

<h1>Movie Collection</h1>

<p>Welcome to my movie collection!</p>
<p>Total movies in my collection: @ViewData["MovieCount"]</p>

<h2 class="mt-4">Movies</h2>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Release Year</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Title</td>
                <td>@movie.ReleaseYear</td>
                <td>
                    <form asp-controller="Movie"
                          asp-action="AddToWatchlist"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@movie.Id" />

                        @if (watchlist.Contains(movie.Id))
                        {
                            <button type="button"
                                class="btn btn-success btn-sm"
                                disabled>
                                ✓ Added to Watchlist
                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                class="btn btn-outline-primary btn-sm">
                                Add to Watchlist
                            </button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>